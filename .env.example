YOUTUBE_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public deployed origin (e.g. https://spike.example.com), used to resolve
# absolute URLs for Open Graph/Twitter metadata. Falls back to
# http://localhost:3000 in local dev when unset.
NEXT_PUBLIC_SITE_URL=

# Shared secret required by POST /api/cron/refresh-trends. Send it either
# as `Authorization: Bearer <value>` (what Vercel Cron sends automatically
# when this var is set) or `?secret=<value>` for manual/local testing.
CRON_SECRET=
